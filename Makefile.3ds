#---------------------------------------------------------------------------------
# WiiFin for the Nintendo 3DS and New 3DS (devkitARM, libctru, citro3d).
#
#   make -f Makefile.3ds            -> WiiFin.3dsx (Homebrew Launcher)
#
# The Wii's sources are built as they are, against source/platform/3ds:
# compat/ gives them libogc's and GRRLIB's headers, the other files there
# implement them on the 3DS (see source/platform/3ds/README.md).  FFmpeg for
# the player: tools/3ds/build_ffmpeg.sh (libs/ffmpeg-3ds).
#---------------------------------------------------------------------------------
.SUFFIXES:

DEVKITPRO   ?= /opt/devkitpro
DEVKITARM   ?= $(DEVKITPRO)/devkitARM
CTRULIB     := $(DEVKITPRO)/libctru
PORTLIBS    := $(DEVKITPRO)/portlibs/3ds
PREFIX      := $(DEVKITARM)/bin/arm-none-eabi-
CC          := $(PREFIX)gcc
CXX         := $(PREFIX)g++
TOOLS       := $(DEVKITPRO)/tools/bin

TARGET      := WiiFin
BUILD       := build3ds
APP_TITLE   = $(APP_NAME)
APP_DESC    := Jellyfin client
APP_AUTHOR  := Fabien MILLET

P3DS        := source/platform/3ds
SOURCES     := source source/core source/input source/ui source/jellyfin source/player $(P3DS) $(P3DS)/ui
# the 3DS version's name (still to be chosen)
APP_NAME    ?= 3DSFin

# The Wii's own pieces, done by $(P3DS) on the 3DS
WII_ONLY    := source/core/LwpJoinFix.cpp source/core/Reload.cpp \
               source/player/OgcCompat.c source/player/vo_wiifin.c source/player/VideoSurface.cpp \
               source/player/WiiPlayer.cpp source/player/stream_wiifin.cpp \
               source/player/AudioSpectrum.cpp source/ui/JpegTexture.cpp

CPPFILES    := $(filter-out $(WII_ONLY),$(foreach dir,$(SOURCES),$(wildcard $(dir)/*.cpp)))
CFILES      := $(filter-out $(WII_ONLY),$(foreach dir,$(SOURCES),$(wildcard $(dir)/*.c)))

SRC_OFILES  := $(addprefix $(BUILD)/,$(notdir $(CPPFILES:.cpp=.o)) $(notdir $(CFILES:.c=.o)))
DEPFILES    := $(SRC_OFILES:.o=.d)

ASSET_OFILES := \
	$(BUILD)/wiifin_shbin.o \
	$(BUILD)/wii_font_ttf.o \
	$(BUILD)/jp_font_ttf.o \
	$(BUILD)/button_start_png.o \
	$(BUILD)/logo_wiifin_png.o \
	$(BUILD)/cursor_pointer_png.o \
	$(BUILD)/cursor_hand_open_png.o \
	$(BUILD)/cursor_hand_closed_png.o \
	$(BUILD)/ring_png.o \
	$(BUILD)/cacert_pem.o \
	$(BUILD)/music_mp3.o \
	$(BUILD)/fx_start_mp3.o \
	$(BUILD)/fx_select_mp3.o \
	$(BUILD)/fx_press_key_mp3.o \
	$(BUILD)/fx_menu_exit_mp3.o \
	$(BUILD)/fx_menu_enter_mp3.o \
	$(BUILD)/fx_loading_mp3.o \
	$(BUILD)/fx_backspace_mp3.o \
	$(BUILD)/fx_back_mp3.o \
	$(BUILD)/lang_mo.o

OFILES      := $(ASSET_OFILES) $(SRC_OFILES)

ARCH        := -march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft
INCLUDE     := -I$(CURDIR)/$(P3DS)/compat \
               $(foreach dir,$(SOURCES),-I$(CURDIR)/$(dir)) -I$(CURDIR)/$(BUILD) \
               -I$(CURDIR)/libs/mbedtls/include -I$(CURDIR)/libs/ffmpeg-3ds/include \
               -I$(CTRULIB)/include -I$(PORTLIBS)/include -I$(PORTLIBS)/include/freetype2 \
               -I$(PORTLIBS)/include/libpng16

WERROR      ?=
CFLAGS      := -g -O2 -Wall $(WERROR) -MMD -MP -mword-relocations -ffunction-sections \
               $(ARCH) -D__3DS__ -DAPP_NAME='"$(APP_NAME)"' $(INCLUDE)
CXXFLAGS    := $(CFLAGS) -fno-rtti -std=gnu++17
LDFLAGS     := -specs=3dsx.specs -g $(ARCH) -Wl,-Map,$(TARGET).3ds.map -Wl,--gc-sections \
               -Wl,--wrap=SYS_Report -Wl,--wrap=GRRLIB_Render
LIBS        := -L$(CURDIR)/libs/ffmpeg-3ds/lib -lavformat -lavcodec -lswresample -lavutil \
               -L$(CURDIR)/libs/mbedtls/lib3ds -lmbedtls -lmbedx509 -lmbedcrypto \
               -L$(PORTLIBS)/lib -lfreetype -lpng16 -lbz2 -ljpeg -lmad -lz \
               -L$(CTRULIB)/lib -lcitro3d -lctru -lm

.PHONY: all clean

all: $(BUILD) $(TARGET).3dsx

$(BUILD):
	mkdir -p $@

$(TARGET).3dsx: $(TARGET).3ds.elf $(BUILD)/$(TARGET).smdh
	$(TOOLS)/3dsxtool $< $@ --smdh=$(BUILD)/$(TARGET).smdh

$(TARGET).3ds.elf: $(OFILES)
	$(CXX) $^ -o $@ $(LDFLAGS) $(LIBS)

$(BUILD)/$(TARGET).smdh: $(P3DS)/icon.png
	$(TOOLS)/smdhtool --create "$(APP_TITLE)" "$(APP_DESC)" "$(APP_AUTHOR)" $< $@

clean:
	rm -rf $(BUILD) $(TARGET).3dsx $(TARGET).3ds.elf $(TARGET).3ds.map

# Sources
vpath %.cpp $(SOURCES)
vpath %.c $(SOURCES)
$(BUILD)/%.o: %.cpp | $(BUILD)
	$(CXX) $(CXXFLAGS) -c $< -o $@
$(BUILD)/%.o: %.c | $(BUILD)
	$(CC) $(CFLAGS) -c $< -o $@

# The vertex shader
$(BUILD)/wiifin_shbin.o: $(P3DS)/shaders/wiifin.v.pica | $(BUILD)
	$(TOOLS)/picasso -o $(BUILD)/wiifin.shbin $<
	(echo 'const unsigned char wiifin_shbin[] __attribute__((aligned(4))) = {'; \
	 xxd -i < $(BUILD)/wiifin.shbin; echo '};'; \
	 echo "const unsigned int wiifin_shbin_size = sizeof(wiifin_shbin);") > $(BUILD)/wiifin_shbin.c
	$(CC) $(ARCH) -c -o $@ $(BUILD)/wiifin_shbin.c

# Embedded files (as in the Wii's Makefile)
define EMBED
$(BUILD)/$(1).o: $(2) | $(BUILD)
	xxd -i -n $(3) $$< > $(BUILD)/$(1).c
	$(CC) $(ARCH) -c -o $$@ $(BUILD)/$(1).c
endef
$(eval $(call EMBED,cursor_pointer_png,data/cursors/PointerP1-64.png,data_cursors_PointerP1_64_png))
$(eval $(call EMBED,cursor_hand_open_png,data/cursors/HandOpenP1-64.png,data_cursors_HandOpenP1_64_png))
$(eval $(call EMBED,cursor_hand_closed_png,data/cursors/HandClosedP1-64.png,data_cursors_HandClosedP1_64_png))
$(eval $(call EMBED,button_start_png,data/images/button_start.png,data_button_start_png))
$(eval $(call EMBED,logo_wiifin_png,data/images/logo_wiifin.png,data_logo_wiifin_png))
$(eval $(call EMBED,wii_font_ttf,data/fonts/wii_font.ttf,data_wii_font_ttf))
$(eval $(call EMBED,jp_font_ttf,data/fonts/jp_font.ttf,data_jp_font_ttf))
$(eval $(call EMBED,ring_png,data/images/ring.png,data_ring_png))
$(eval $(call EMBED,music_mp3,data/sounds/bgm.mp3,data_music_mp3))
$(eval $(call EMBED,fx_start_mp3,data/sounds/start.mp3,data_sounds_start_mp3))
$(eval $(call EMBED,fx_select_mp3,data/sounds/select.mp3,data_sounds_select_mp3))
$(eval $(call EMBED,fx_back_mp3,data/sounds/back.mp3,data_sounds_back_mp3))
$(eval $(call EMBED,fx_backspace_mp3,data/sounds/backspace.mp3,data_sounds_backspace_mp3))
$(eval $(call EMBED,fx_loading_mp3,data/sounds/loading.mp3,data_sounds_loading_mp3))
$(eval $(call EMBED,fx_menu_enter_mp3,data/sounds/menu_enter.mp3,data_sounds_menu_enter_mp3))
$(eval $(call EMBED,fx_menu_exit_mp3,data/sounds/menu_exit.mp3,data_sounds_menu_exit_mp3))
$(eval $(call EMBED,fx_press_key_mp3,data/sounds/press_key.mp3,data_sounds_press_key_mp3))

$(BUILD)/cacert_pem.o: data/certs/cacert.pem | $(BUILD)
	(cat $<; printf '\0') > $(BUILD)/cacert_pem_null.pem
	xxd -i -n data_cacert_pem $(BUILD)/cacert_pem_null.pem > $(BUILD)/cacert_pem.c
	$(CC) $(ARCH) -c -o $@ $(BUILD)/cacert_pem.c

LANG_PO := $(sort $(wildcard lang/*.po))
$(BUILD)/lang_mo.o: $(LANG_PO) tools/lang_table.sh | $(BUILD)
	bash tools/lang_table.sh $(BUILD) $(LANG_PO) > $(BUILD)/lang_mo.c
	$(CC) $(ARCH) -c -o $@ $(BUILD)/lang_mo.c

-include $(DEPFILES)
